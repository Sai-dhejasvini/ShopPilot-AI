# LLM Configuration
# Options: "mock", "anthropic", "openai", "gemini"
LLM_PROVIDER=mock

# API Keys (fill with your keys when ready; keep as 'mock' for offline development)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Models
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# Ranking Engine Default Weights (must sum to 1.0)
WEIGHT_BUDGET=0.30
WEIGHT_RATING=0.25
WEIGHT_FEATURE=0.25
WEIGHT_POPULARITY=0.10
WEIGHT_AVAILABILITY=0.10

# App Settings
CURRENCY_SYMBOL=₹
DEFAULT_TOP_N=5
